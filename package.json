{
  "name": "optimus-monorepo",
  "version": "1.0.0",
  "description": "Optimus AI Platform - Unified Monorepo with Optimus IDE",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "dev": "turbo dev --filter=./apps/*",
    "dev:optimus": "turbo dev --filter=apps/optimus",
    "dev:ide": "turbo dev --filter=apps/optimus-ide",
    "build": "turbo build",
    "build:optimus": "turbo build --filter=apps/optimus",
    "build:ide": "turbo build --filter=apps/optimus-ide",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "format": "turbo format",
    "format:check": "turbo format:check"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "1.1.13",
      "lodash": "4.18.1",
      "minimatch@<4": "3.1.3",
      "minimatch@>=9": "9.0.7",
      "glob@>=10": "10.5.0",
      "picomatch": "2.3.2",
      "js-yaml": "4.1.1"
    }
  }
}
